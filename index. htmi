    <script>
        // Categories
        const categories = [
            { name: "Wall Decor", icon: "fa-image" },
            { name: "Lighting", icon: "fa-lightbulb" },
            { name: "Luxury Vase", icon: "fa-wine-bottle" },
            { name: "Mirror", icon: "fa-circle" },
            { name: "Office Decor", icon: "fa-briefcase" },
            { name: "Artificial Plant", icon: "fa-seedling" },
            { name: "Bedroom Decor", icon: "fa-bed" },
            { name: "Table Decor", icon: "fa-couch" }
        ];
        const catContainer = document.getElementById('categories-container');
        categories.forEach(item => {
            catContainer.innerHTML += `
                <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-md transition duration-300 text-center font-bold cursor-pointer border border-gray-100 hover:border-yellow-500 group">
                    <div class="w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center mx-auto mb-3 group-hover:bg-yellow-50 group-hover:text-yellow-600 transition text-gray-500 text-lg">
                        <i class="fas ${item.icon}"></i>
                    </div>
                    <span class="text-gray-800 group-hover:text-yellow-600 transition text-sm">${item.name}</span>
                </div>
            `;
        });

        // Premium Products
        const products = [
            { name: "Luxury Ceramic Vase", oldPrice: "৳১,৮০০", price: "৳১,২৫০", image: "https://images.unsplash.com/photo-1578500494198-246f612d3b3d?q=80&w=600&auto=format&fit=crop", badge: "১০% OFF" },
            { name: "Modern Nordic Pendant Light", oldPrice: "৳৪,২০০", price: "৳৩,৫০০", image: "https://images.unsplash.com/photo-1507473885765-e6ed057f782c?q=80&w=600&auto=format&fit=crop", badge: "POPULAR" },
            { name: "Abstract Premium Wall Art", oldPrice: "৳২,৮০০", price: "৳২,foreground", image: "https://images.unsplash.com/photo-1513519245088-0e12902e5a38?q=80&w=600&auto=format&fit=crop", badge: "BEST SELLER", priceNum: "৳২,২০০" }
        ];
        
        // Quick price fix for last item
        products[2].price = "৳২,২০০";

        const prodContainer = document.getElementById('products-container');
        products.forEach(prod => {
            prodContainer.innerHTML += `
                <div class="bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-xl transition duration-300 flex flex-col h-full group transform hover:-translate-y-1">
                    <div class="relative overflow-hidden">
                        <span class="absolute top-4 left-4 z-10 bg-red-500 text-white text-[10px] font-extrabold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">${prod.badge}</span>
                        <img src="${prod.image}" class="w-full h-72 object-cover group-hover:scale-105 transition duration-500" alt="${prod.name}">
                    </div>
                    <div class="p-6 flex flex-col flex-grow">
                        <h3 class="text-lg font-bold mb-2 text-gray-900 group-hover:text-yellow-600 transition">${prod.name}</h3>
                        <div class="flex items-center gap-2 mb-5">
                            <span class="text-yellow-600 font-black text-lg">${prod.price}</span>
                            <span class="text-gray-400 line-through text-sm">${prod.oldPrice}</span>
                        </div>
                        <button class="mt-auto w-full bg-black text-white py-3.5 rounded-xl hover:bg-yellow-500 hover:text-black transition duration-300 font-semibold text-sm flex items-center justify-center gap-2 shadow-sm">
                            <i class="fas fa-shopping-cart text-xs"></i> Add to Cart
                        </button>
                    
                
